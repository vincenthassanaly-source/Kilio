{ "nom": "5-recette-creer-modifier", "theme": "clair", "etapes": [
 { "action": "goto", "url": "/nutrition/recettes" },
 { "action": "fill", "cible": "role=searchbox", "valeur": "brocoli", "note": "recherche par ingrédient" },
 { "action": "fill", "cible": "role=searchbox", "valeur": "" },
 { "action": "click", "cible": "role=button[name=/ajouter une recette/i]" },
 { "action": "click", "cible": "form button[type=submit]", "note": "valider avec le nom vide" },
 { "action": "fill", "cible": "input[name=nom]", "valeur": "Gratin de courgettes au fromage blanc, façon grand-mère, à préparer la veille pour le déjeuner du lendemain au bureau", "note": "nom très long" },
 { "action": "fill", "cible": "input[name=portions]", "valeur": "3" },
 { "action": "fill", "cible": "input[name=temps_prepa_min]", "valeur": "40" },
 { "action": "dblclick", "cible": "form button[type=submit]", "note": "double tap sur Ajouter" },
 { "action": "wait", "ms": 2000 },
 { "action": "screenshot", "note": "après création" },
 { "action": "goto", "url": "/nutrition/recettes", "note": "liste : une seule nouvelle recette ?" },
 { "action": "click", "cible": "role=link[name=/Gratin de courgettes/i]", "note": "ouvrir la fiche" },
 { "action": "click", "cible": "role=button[name=/^Modifier/] >> nth=0", "note": "modifier la recette" },
 { "action": "fill", "cible": "input[name=nom]", "valeur": "Gratin de courgettes" },
 { "action": "click", "cible": "role=button[name=/^Enregistrer/]" },
 { "action": "expect_text", "texte": "Gratin de courgettes" },
 { "action": "scroll", "pixels": 600 },
 { "action": "fill", "cible": "textarea[name=consigne]", "valeur": "Couper les courgettes en rondelles fines." },
 { "action": "click", "cible": "role=button[name=/Ajouter l'étape/i]" },
 { "action": "expect_text", "texte": "Couper les courgettes" },
 { "action": "click", "cible": "[aria-label=\"Supprimer l'étape 1\"]", "note": "supprimer l'étape" },
 { "action": "click", "cible": "role=button[name=/annuler/i]", "note": "Annuler" },
 { "action": "reload" },
 { "action": "expect_text", "texte": "Couper les courgettes" }
]}
